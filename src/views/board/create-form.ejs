<div class="card" style="width: 18rem">
  <div class="card-header">
    <h5 class="mb-0">New Board</h5>
  </div>
  <div class="card-body">
    <form method="POST" id="create-board-form">
      <div class="mb-3">
        <label class="form-label" for="name">Board name:</label>
        <input
          class="form-control form-control-lg fw-bold"
          type="text"
          name="name"
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="description">Description:</label>
        <textarea class="form-control" name="description"></textarea>
      </div>

      <button class="btn btn-light btn-sm" type="submit">Create</button>
    </form>
  </div>
</div>
